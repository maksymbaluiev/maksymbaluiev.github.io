---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Blog" description="Notes and articles by Maksym Baluiev.">
  <section class="cols wrap">
    <h1 class="label">Blog</h1>
    <p class="msg">Coming soon.</p>
  </section>
</BaseLayout>

<style>
  .wrap { padding-top: var(--space-xl); align-items: start; }
  h1 { grid-column: 1 / -1; }
  .msg { grid-column: 1 / -1; }
  @media (min-width: 768px) {
    h1 { grid-column: 1 / 2; grid-row: 1; }
    .msg { grid-column: 2 / -1; grid-row: 1; }
  }
  @media (min-width: 1024px) {
    h1 { grid-column: 5 / 7; }
    .msg { grid-column: 7 / -1; }
  }
</style>
