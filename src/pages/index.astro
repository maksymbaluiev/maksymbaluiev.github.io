---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import { getProjects } from '../lib/projects';
import { SITE } from '../site.config';

const projects = await getProjects();
---

<BaseLayout>
  <!-- Заголовки для читалок екрана і пошуковиків, на екрані не видно -->
  <h1 class="visually-hidden">{SITE.name}, designer</h1>
  <section class="container work" aria-labelledby="work-title">
    <h2 id="work-title" class="visually-hidden">Selected work</h2>
    <ProjectGrid projects={projects} />
  </section>
</BaseLayout>

<style>
  /* Великий порожній відступ під шапкою, як у референсі:
     сітка починається приблизно на 27% ширини екрана від верху */
  .work { padding-top: max(var(--space-l), 19vw); }
</style>
