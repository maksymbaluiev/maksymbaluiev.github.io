---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../site.config';

const social = SITE.social.filter((s) => s.url);
const { profile, approach, services, clients, recognition, industries, experience } = SITE.about;

// Блок «Info»: показуються лише непорожні групи.
// inline: true = елементи через кому одним абзацом (як список клієнтів)
const info = [
  { label: 'Services', items: services },
  { label: 'Experience', items: experience, inline: true },
  { label: 'Clients', items: clients, inline: true },
  { label: 'Recognition', items: recognition },
  { label: 'Industries', items: industries },
  { label: 'Based in', items: [SITE.location] },
].filter((g) => g.items.length > 0);

// Нумерація секцій рахується автоматично
const sections = ['Profile', approach ? 'Approach' : null, 'Info', 'Contact'].filter(Boolean) as string[];
const num = (name: string) => `${sections.indexOf(name) + 1}.`;
---

<BaseLayout title="About" description={SITE.description}>
  <h1 class="visually-hidden">About {SITE.name}</h1>

  <section class="cols14 sec sec--profile" aria-labelledby="s-profile">
    <h2 id="s-profile" class="tag"><span class="pill">{num('Profile')} Profile</span></h2>
    <p class="display">{profile}</p>
  </section>

  {approach && (
    <section class="cols14 sec sec--approach" aria-labelledby="s-approach">
      <h2 id="s-approach" class="tag"><span class="pill">{num('Approach')} Approach</span></h2>
      <p class="display">{approach}</p>
    </section>
  )}

  <section class="cols14 sec sec--info" aria-labelledby="s-info">
    <h2 id="s-info" class="tag"><span class="pill">{num('Info')} Info</span></h2>
    <dl class="body">
      {info.map((g) => (
        <div class="group">
          <dt>{g.label}</dt>
          {g.inline ? <dd>{g.items.join(', ')}</dd> : g.items.map((item) => <dd>{item}</dd>)}
        </div>
      ))}
    </dl>
  </section>

  <section class="cols14 sec sec--info" aria-labelledby="s-contact">
    <h2 id="s-contact" class="tag"><span class="pill">{num('Contact')} Contact</span></h2>
    <ul role="list" class="body">
      <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
      {social.map((s) => <li><a href={s.url} rel="me noopener">{s.label}</a></li>)}
    </ul>
  </section>
</BaseLayout>

<style>
  /* Сітка 14 колонок. Мітка і текст стоять в одному рядку сітки. */
  .sec { align-items: start; }
  .tag, .display, .body { grid-row: 1; }

  /* Усі секції однаково: мітка з 6-ї колонки, текст з 9-ї */
  .tag { grid-column: 6 / 9; }
  .display, .body { grid-column: 9 / -1; max-width: var(--prose-max); }
  .display { line-height: var(--leading-normal); }
  .sec--profile { padding-top: var(--space-xl); }
  .sec + .sec { margin-top: max(var(--space-l), 4vw); }
  .group + .group { margin-top: 0.35em; }
  dt { color: var(--color-text-muted); }
  dd { margin: 0; padding-left: 1em; max-width: 36em; }
  .body a { text-decoration: none; }
  .body a:hover { color: var(--color-text-muted); }
  ul.body li { line-height: 1.6; }

  /* Телефон: мітка над текстом */
  @media (max-width: 767px) {
    .tag { grid-column: 1 / -1; }
    .display, .body { grid-column: 1 / -1; grid-row: 2; margin-top: var(--space-2xs); }
  }
</style>
