---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../site.config';

const social = SITE.social.filter((s) => s.url);
const { profile, approach, services, clients } = SITE.about;
---

<BaseLayout title="About" description={SITE.description}>
  <h1 class="visually-hidden">About {SITE.name}</h1>

  <!-- Кожна секція: сіра назва зліва, білий текст справа -->
  <section class="cols sec sec--first" aria-labelledby="s-profile">
    <h2 id="s-profile" class="tag">Profile</h2>
    <p class="body">{profile}</p>
  </section>

  {approach && (
    <section class="cols sec" aria-labelledby="s-approach">
      <h2 id="s-approach" class="tag">Approach</h2>
      <p class="body">{approach}</p>
    </section>
  )}

  {services.length > 0 && (
    <section class="cols sec" aria-labelledby="s-services">
      <h2 id="s-services" class="tag">Services</h2>
      <ul role="list" class="body">{services.map((s) => <li>{s}</li>)}</ul>
    </section>
  )}

  {clients.length > 0 && (
    <section class="cols sec" aria-labelledby="s-clients">
      <h2 id="s-clients" class="tag">Clients</h2>
      <p class="body">{clients.join(', ')}</p>
    </section>
  )}

  <section class="cols sec" id="contact" aria-labelledby="s-contact">
    <h2 id="s-contact" class="tag">Contact</h2>
    <ul role="list" class="body">
      <li>
        <!-- Наведення: «Copy email». Клік: копіює адресу (без JS відкриває пошту). -->
        <a class="copy-email" href={`mailto:${SITE.email}`} data-email={SITE.email}>
          <span class="ce-default">{SITE.email}</span>
          <span class="ce-hover" aria-hidden="true">Copy email</span>
          <span class="ce-done" aria-hidden="true">Copied</span>
        </a>
        <span class="visually-hidden" aria-live="polite" data-copy-status></span>
      </li>
      {social.map((s) => <li><a href={s.url} target="_blank" rel="me noopener noreferrer">{s.label}</a></li>)}
    </ul>
  </section>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLAnchorElement>('.copy-email').forEach((link) => {
    const status = link.parentElement?.querySelector('[data-copy-status]');
    link.addEventListener('click', async (e) => {
      const email = link.dataset.email;
      if (!email || !navigator.clipboard) return; // без буфера: звичайне посилання mailto
      e.preventDefault();
      try {
        await navigator.clipboard.writeText(email);
        link.classList.add('is-copied');
        if (status) status.textContent = 'Email copied';
        setTimeout(() => {
          link.classList.remove('is-copied');
          if (status) status.textContent = '';
        }, 1600);
      } catch {
        window.location.href = `mailto:${email}`;
      }
    });
  });
</script>

<style>
  /* 12 колонок: назва з 5-ї колонки, текст з 7-ї. Телефон: назва над текстом. */
  .sec { align-items: start; }
  .tag { color: var(--color-text-muted); grid-column: 1 / -1; }
  .body { grid-column: 1 / -1; margin-top: var(--space-2xs); max-width: var(--prose-max); line-height: var(--leading-normal); }
  ul.body { line-height: var(--leading-ui); }
  .sec--first { padding-top: var(--space-xl); }
  .sec + .sec { margin-top: max(var(--space-l), 4vw); }

  @media (min-width: 768px) {
    .tag { grid-column: 5 / 7; grid-row: 1; }
    .body { grid-column: 7 / -1; grid-row: 1; margin-top: 0; }
  }

  .body a { text-decoration: none; }
  .body a:hover { color: var(--color-text-muted); }
  ul.body li a { display: inline-block; padding-block: 0.2em; }

  /* Email: три стани в одній «комірці», щоб текст не стрибав */
  ul.body li a.copy-email { display: inline-grid; justify-items: start; cursor: pointer; }
  .copy-email > span { grid-area: 1 / 1; transition: opacity 0.2s var(--ease); }
  .ce-hover, .ce-done { opacity: 0; }
  .copy-email:hover { color: inherit; }
  .copy-email:hover .ce-default, .copy-email:focus-visible .ce-default { opacity: 0; }
  .copy-email:hover .ce-hover, .copy-email:focus-visible .ce-hover { opacity: 1; color: var(--color-text-muted); }
  .copy-email.is-copied .ce-default, .copy-email.is-copied .ce-hover { opacity: 0; }
  .copy-email.is-copied .ce-done { opacity: 1; }
</style>
