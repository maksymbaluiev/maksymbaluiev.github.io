---
import { render } from 'astro:content';
import { getImage, Picture } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getProjects, getProjectImages, getCover, type Project } from '../../lib/projects';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, next: projects[(i + 1) % projects.length] },
  }));
}

interface Props { project: Project; next: Project }
const { project, next } = Astro.props;
const { Content } = await render(project);
const images = getProjectImages(project);
// Велика версія кожної картинки для попапу (GIF — оригінал, щоб жила анімація)
const large = await Promise.all(
  images.map(async (img) =>
    img.src.format === 'gif'
      ? img.src.src
      : (await getImage({ src: img.src, width: Math.min(img.src.width, 3200), format: 'webp' })).src,
  ),
);
const og = await getImage({ src: getCover(project).src, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
const { title, summary, services, year, links, credits } = project.data;
const [mainLink, ...otherLinks] = links;

// Таблиця під описом: номер · назва · значення
const rows = [
  ...(services.length ? [{ label: 'Services', value: services.join(', ') }] : []),
  ...credits,
  ...(year ? [{ label: 'Year', value: String(year) }] : []),
];
---

<BaseLayout title={title} description={summary} image={og.src} type="article">
  <article class="cols project">
    <!-- Ліва частина: на десктопі стоїть на місці, поки гортаються картинки -->
    <aside class="info">
      <div class="head">
        <h1>{title}</h1>
        {mainLink && <a class="ext" href={mainLink.url} rel="noopener">{mainLink.label} ↗</a>}
      </div>

      <div class="text"><Content /></div>

      {rows.length > 0 && (
        <dl class="rows">
          {rows.map((r, i) => (
            <div class="row">
              <span class="n" aria-hidden="true">{i + 1}</span>
              <dt>{r.label}</dt>
              <dd>{r.value}</dd>
            </div>
          ))}
        </dl>
      )}

      {otherLinks.length > 0 && (
        <ul role="list" class="more">
          {otherLinks.map((l) => <li><a href={l.url} rel="noopener">{l.label} ↗</a></li>)}
        </ul>
      )}

      {next.id !== project.id && (
        <a class="next" href={`/work/${next.id}/`}><span class="label">Next</span> {next.data.title} →</a>
      )}

      <!-- Десктоп: стрілка внизу лівої колонки, повертає на початок сторінки -->
      <a class="to-top" href="#top" aria-label="Back to top">
        <svg viewBox="0 0 12 40" aria-hidden="true"><path d="M6 39V1M1 6l5-5 5 5" fill="none" stroke="currentColor" stroke-width="1"/></svg>
      </a>
    </aside>

    <!-- Права частина: картинки -->
    <div class="media">
      {images.map((img, i) => (
        <figure>
          <button class="zoom" type="button" data-index={i} data-large={large[i]} aria-label={`Open image ${i + 1} larger`}>
          {img.src.format === 'gif' ? (
            /* GIF показуємо як є, щоб не зламати анімацію */
            <img
              src={img.src.src}
              alt={img.alt}
              width={img.src.width}
              height={img.src.height}
              loading={i === 0 ? 'eager' : 'lazy'}
              decoding="async"
            />
          ) : (
            <Picture
              src={img.src}
              alt={img.alt}
              formats={['avif', 'webp']}
              widths={[640, 960, 1280, 1600, 2000, 2400, 3200, 3840]}
              sizes="(min-width: 1024px) 66vw, calc(100vw - 2.25rem)"
              loading={i === 0 ? 'eager' : 'lazy'}
            />
          )}
          </button>
        </figure>
      ))}
    </div>
  </article>

  <!-- Попап зі збільшеною картинкою -->
  <dialog class="lightbox" aria-label="Image viewer">
    <img class="lb-img" alt="" />
    <button class="lb-btn lb-close" type="button" aria-label="Close">×</button>
    {images.length > 1 && (
      <>
        <button class="lb-btn lb-prev" type="button" aria-label="Previous image">←</button>
        <button class="lb-btn lb-next" type="button" aria-label="Next image">→</button>
      </>
    )}
  </dialog>

  <!-- Телефон: кнопка «Close» внизу екрана, повертає на головну -->
  <a class="close" href="/">Close</a>
</BaseLayout>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('.lightbox');
  const big = dialog?.querySelector<HTMLImageElement>('.lb-img');
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('.zoom')];
  let current = 0;

  const show = (i: number) => {
    if (!dialog || !big || !buttons.length) return;
    current = (i + buttons.length) % buttons.length;
    const btn = buttons[current];
    big.src = btn.dataset.large ?? '';
    big.alt = btn.querySelector('img')?.alt ?? '';
  };
  const open = (i: number) => {
    show(i);
    dialog?.showModal();
    (window as any).lenis?.stop();
  };

  buttons.forEach((b, i) => b.addEventListener('click', () => open(i)));
  dialog?.querySelector('.lb-close')?.addEventListener('click', () => dialog.close());
  dialog?.querySelector('.lb-prev')?.addEventListener('click', (e) => { e.stopPropagation(); show(current - 1); });
  dialog?.querySelector('.lb-next')?.addEventListener('click', (e) => { e.stopPropagation(); show(current + 1); });
  // Клік по фону або по картинці закриває
  dialog?.addEventListener('click', (e) => {
    if (!(e.target as HTMLElement).closest('.lb-btn')) dialog.close();
  });
  dialog?.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') show(current - 1);
    if (e.key === 'ArrowRight') show(current + 1);
  });
  dialog?.addEventListener('close', () => {
    (window as any).lenis?.start();
    buttons[current]?.focus({ preventScroll: true });
  });
</script>

<style>
  /*
    Телефон: усе одне під одним.
    Десктоп (від 1024 px): інфо в колонках 1–5 стоїть на місці, картинки в колонках 6–14.
  */
  .project {
    row-gap: var(--space-l);
    padding-top: max(var(--space-l), 8vw);
  }
  .info, .media { grid-column: 1 / -1; }

  .head { display: flex; justify-content: space-between; gap: var(--space-s); align-items: baseline; }
  .ext, .next, .more a { text-decoration: none; }
  .ext:hover, .next:hover, .more a:hover { color: var(--color-text-muted); }

  .text { margin-top: var(--space-l); max-width: var(--prose-max); }
  .text :global(* + *) { margin-top: 1em; }
  .text :global(ul) { padding-left: 1.2em; }

  /* Таблиця: номер, назва (сіра), значення */
  .rows { margin-top: var(--space-l); }
  .row {
    display: grid;
    grid-template-columns: 1fr 1fr 3fr;
    column-gap: var(--space-xs);
  }
  .n, dt { color: var(--color-text-muted); }
  dd { margin: 0; }

  .more { margin-top: var(--space-s); }
  .next { display: inline-block; margin-top: var(--space-l); }

  .media { display: grid; gap: var(--space-2xs); }
  figure { background: var(--color-surface); }
  .zoom { display: block; width: 100%; padding: 0; border: 0; background: none; cursor: zoom-in; }

  /* Попап */
  .lightbox {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: var(--pad);
    border: 0;
    background: transparent;
    color: var(--color-text);
    overflow: hidden;
    cursor: zoom-out;
  }
  .lightbox[open] { display: grid; place-items: center; animation: lb-in 0.25s var(--ease); }
  .lightbox::backdrop { background: rgba(0, 0, 0, 0.92); }
  .lb-img {
    max-width: 100%;
    max-height: calc(100dvh - 2 * var(--pad));
    width: auto;
    height: auto;
    object-fit: contain;
  }
  .lb-btn {
    position: fixed;
    min-width: var(--tap-min);
    min-height: var(--tap-min);
    display: grid;
    place-items: center;
    background: none;
    border: 0;
    color: inherit;
    font: inherit;
    font-size: 1.5em;
    cursor: pointer;
  }
  .lb-btn:hover { color: var(--color-text-muted); }
  .lb-close { top: var(--space-2xs); right: var(--space-2xs); }
  .lb-prev { left: var(--space-2xs); top: 50%; transform: translateY(-50%); }
  .lb-next { right: var(--space-2xs); top: 50%; transform: translateY(-50%); }
  @keyframes lb-in { from { opacity: 0; } to { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) { .lightbox[open] { animation: none; } }
  figure :global(img) { width: 100%; }

  .to-top { display: none; text-decoration: none; }
  .to-top:hover { color: var(--color-text-muted); }

  .close {
    position: fixed;
    left: 50%;
    bottom: var(--space-s);
    transform: translateX(-50%);
    z-index: 5;
    padding: 0.5em 0.9em;
    min-height: var(--tap-min);
    display: inline-flex;
    align-items: center;
    background: var(--color-surface);
    border-radius: 0.4em;
    text-decoration: none;
  }

  @media (min-width: 1024px) {
    .project { align-items: start; }
    .info {
      grid-column: 1 / 5;
      grid-row: 1;
      padding-right: var(--space-m);
      position: sticky;
      top: var(--pad);
      /* якщо текст довший за екран, гортається тільки ця колонка */
      height: calc(100dvh - 2 * var(--pad));
      overflow-y: auto;
      scrollbar-width: none;
      display: flex;
      flex-direction: column;
    }
    /* Стрілка завжди внизу лівої колонки */
    .to-top {
      display: inline-flex;
      align-items: center;
      min-height: var(--tap-min);
      margin-top: auto;
      align-self: flex-end;   /* правий нижній кут лівого блоку */
      /* Зона кліку значно ширша за саму стрілку; стрілка стоїть біля правого краю */
      justify-content: flex-end;
      min-width: 6em;
      padding: var(--space-m) 0 0 3em;
    }
    /* Довга тонка стрілка: висота ~3 рядки тексту */
    .to-top svg { width: 0.6em; height: 3em; overflow: visible; }
    .media { grid-column: 5 / -1; grid-row: 1; }
    .close { display: none; }
  }
</style>
