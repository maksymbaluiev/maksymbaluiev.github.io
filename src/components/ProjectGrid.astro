---
import ProjectCard from './ProjectCard.astro';
import type { Project } from '../lib/projects';

interface Props { projects: Project[] }
const { projects } = Astro.props;
---

<ul role="list" class="grid">
  {
    projects.map((project, i) => (
      <li>
        <ProjectCard project={project} index={i} eager={i < 2} />
      </li>
    ))
  }
</ul>

<style>
  /*
    Та сама сітка, що й на всьому сайті (2 / 12 колонок).
    Картка займає: телефон 2 з 2 (1 в ряд), від 768 px 4 з 12 (3 в ряд).
  */
  .grid {
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    gap: var(--space-l) var(--gap);
  }
  li { grid-column: span 2; }
  @media (min-width: 768px) { li { grid-column: span 4; } }
</style>
