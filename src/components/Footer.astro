---
import { SITE } from '../site.config';
const social = SITE.social.filter((s) => s.url);
const year = new Date().getFullYear();
---

<!-- Підвал: пункти стоять по колонках сітки (12 на десктопі, 2 на телефоні) -->
<footer class="site-footer cols">
  <ul role="list" class="items">
    <li class="legal">©{year}<br />Privacy Policy</li>
    {social.map((s) => (
      <li><a href={s.url} target="_blank" rel="me noopener noreferrer">{s.label}</a></li>
    ))}
  </ul>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-xl);
    padding-block: var(--space-m);
  }
  /* Список сам стає сіткою сайту */
  .items {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: subgrid;
    row-gap: var(--space-3xs);
  }
  /*
    Соцмережі: по одній у колонках 1–4, по лівому краю колонки.
    ©/Privacy Policy: в останній колонці, по правому краю.
    Усе вирівняно по нижньому краю.
  */
  li { align-self: end; white-space: nowrap; }
  .legal { grid-column: -2 / -1; grid-row: 1 / span 4; justify-self: end; text-align: right; }
  li:not(.legal) { grid-column: 1; }          /* телефон: соцмережі стовпчиком зліва */

  @media (min-width: 768px) {
    .legal { grid-row: 1; }
    li:not(.legal) { grid-row: 1; grid-column: span 2; }   /* планшет: колонки вузькі, тож по дві */
  }
  @media (min-width: 1024px) {
    li:not(.legal) { grid-column: span 1; }                /* десктоп: колонки 1, 2, 3, 4 */
  }

  /* Однаковий відступ у всіх пунктах, щоб нижні лінії тексту збігались */
  li { padding-block: 0.35em; }
  a { text-decoration: none; display: block; }
  /* Наведення: сірий, як у меню */
  a:hover { color: var(--color-text-muted); }
</style>
