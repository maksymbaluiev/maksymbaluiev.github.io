---
import { SITE } from '../site.config';
const social = SITE.social.filter((s) => s.url);
const year = new Date().getFullYear();
---

<!-- Підвал: пункти стоять по колонках сітки (12 на десктопі, 2 на телефоні) -->
<footer class="site-footer cols">
  <ul role="list" class="items">
    <li>©{year}</li>
    <li>Privacy Policy</li>
    {social.map((s) => (
      <li><a href={s.url} target="_blank" rel="me noopener noreferrer">{s.label}</a></li>
    ))}
  </ul>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-xl);
    padding-block: var(--space-m);
  }
  /* Список сам стає сіткою: кожен пункт займає одну «пару» колонок */
  .items {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: subgrid;
    row-gap: var(--space-3xs);
  }
  li { grid-column: span 1; }
  @media (min-width: 768px) {
    li { grid-column: span 2; }
  }

  a { text-decoration: none; display: inline-block; padding-block: 0.35em; }
  li:not(:has(a)) { padding-block: 0.35em; }
  /* Наведення: сірий, як у меню */
  a:hover { color: var(--color-text-muted); }
</style>
