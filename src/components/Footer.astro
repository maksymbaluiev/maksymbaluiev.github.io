---
import { SITE } from '../site.config';
const social = SITE.social.filter((s) => s.url);
const year = new Date().getFullYear();
---

<footer class="site-footer cols14" id="contact">
  <a class="email" href={`mailto:${SITE.email}`}>{SITE.email}</a>
  {
    social.length > 0 && (
      <ul role="list" class="social">
        {social.map((s) => (
          <li><a href={s.url} rel="me noopener">{s.label}</a></li>
        ))}
      </ul>
    )
  }
  <p class="copy">© {year} {SITE.name}</p>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-xl);
    padding-block: var(--space-m);
    row-gap: var(--space-2xs);
    align-items: start;
  }
  a { text-decoration: none; display: inline-flex; align-items: center; min-height: var(--tap-min); }
  a:hover { color: var(--color-text-muted); }
  .email { grid-column: 1 / -1; }
  .social { grid-column: 1 / -1; display: flex; flex-wrap: wrap; gap: 0 var(--space-xs); }
  .copy { grid-column: 1 / -1; color: var(--color-text-muted); }
  @media (min-width: 768px) {
    .email { grid-column: 1 / 6; }
    .social { grid-column: 6 / 12; }
    .copy { grid-column: 12 / -1; justify-self: end; align-self: center; }
  }
</style>
