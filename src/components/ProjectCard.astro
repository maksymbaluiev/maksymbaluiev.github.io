---
import { Picture } from 'astro:assets';
import { getCover, type Project } from '../lib/projects';

interface Props {
  project: Project;
  index: number;
  /** Картки першого екрана вантажимо одразу, решту — ліниво */
  eager?: boolean;
}

const { project, index, eager = false } = Astro.props;
const cover = getCover(project);
const num = String(index + 1).padStart(2, '0');
---

<article class="card">
  <a href={`/work/${project.id}/`} class="link">
    <div class="media">
      <Picture
        src={cover.src}
        alt={cover.alt}
        formats={['avif', 'webp']}
        widths={[400, 640, 800, 1200, 1600]}
        sizes="(min-width: 3600px) 640px, (min-width: 2880px) 20vw, (min-width: 1920px) 25vw, (min-width: 1280px) 33vw, (min-width: 768px) 50vw, 100vw"
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={index === 0 ? 'high' : 'auto'}
      />
    </div>
    <div class="meta">
      <h2 class="title">{project.data.title}</h2>
      <span class="num" aria-hidden="true">{num}</span>
    </div>
  </a>
  {project.data.services.length > 0 && <p class="label">{project.data.services.join(', ')}</p>}
</article>

<style>
  .link { display: block; text-decoration: none; }
  .media {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--color-surface);
    border-radius: var(--radius);
  }
  .media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform calc(var(--duration) * 2) var(--ease);
  }
  .link:hover .media :global(img) { transform: scale(1.02); }
  .meta {
    display: flex;
    justify-content: space-between;
    gap: var(--space-xs);
    margin-top: var(--space-2xs);
  }
  .title { font-size: var(--step-0); }
  .num { font-size: var(--step--1); color: var(--color-text-muted); font-family: var(--font-mono); }
  .link:hover .title { color: var(--color-text-muted); }
  .label { margin-top: var(--space-3xs); }
</style>
