---
import { Picture } from 'astro:assets';
import { getCover, type Project } from '../lib/projects';

interface Props {
  project: Project;
  index: number;
  /** Картки першого екрана вантажимо одразу, решту — ліниво */
  eager?: boolean;
}

const { project, index, eager = false } = Astro.props;
const cover = getCover(project);
const num = String(index + 1).padStart(2, '0');
---

<article class="card">
  <a href={`/work/${project.id}/`} class="link">
    <!-- Підпис над картинкою: [01] Назва, тим самим розміром, що й меню -->
    <h2 class="title"><span class="num">[{num}]</span> {project.data.title}</h2>
    <div class="media">
      <Picture
        src={cover.src}
        alt={cover.alt}
        formats={['avif', 'webp']}
        widths={[400, 640, 800, 1200, 1600, 2000, 2560]}
        sizes="(min-width: 900px) 33vw, 100vw"
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={index === 0 ? 'high' : 'auto'}
      />
    </div>
  </a>
</article>

<style>
  .link { display: block; text-decoration: none; }
  .title { margin-bottom: var(--space-3xs); }
  .link:hover .title { color: var(--color-text-muted); }
  /* Усі обкладинки однакового розміру 4:3, картинка обрізається по центру */
  .media {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--color-surface);
    border-radius: var(--radius);
  }
  .media :global(picture) { display: block; height: 100%; }
  .media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform calc(var(--duration) * 2) var(--ease);
  }
  .link:hover .media :global(img) { transform: scale(1.02); }
</style>
