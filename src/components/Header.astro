---
import { SITE } from '../site.config';

const path = Astro.url.pathname;
const blog = SITE.nav.find((n) => n.label === 'Blog');
const rest = SITE.nav.filter((n) => n.label !== 'Blog');
const isActive = (href: string) => path.startsWith(href);
---

<header class="site-header cols14">
  <a class="name" href="/">{SITE.name}</a>

  <ul role="list" class="locations">
    {SITE.locations.map((l) => <li>{l}</li>)}
  </ul>

  <div class="services">
    <p class="label">Services</p>
    <ul role="list">
      {SITE.headerServices.map((s) => <li>{s}</li>)}
    </ul>
  </div>

  <nav aria-label="Main" class="nav">
    {blog && (
      <a class="blog" href={blog.href} aria-current={isActive(blog.href) ? 'page' : undefined}>{blog.label}</a>
    )}
    {rest.map((item) => (
      <a class="pair" href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
    ))}
  </nav>
</header>

<style>
  /*
    14 колонок:
    1 ім'я · 3 міста · 6 послуги · 9 Blog · праворуч About | Contact
  */
  .site-header {
    align-items: start;
    padding-block: var(--space-xs);
    row-gap: var(--space-2xs);
  }
  a { text-decoration: none; }

  /* Наведення і активний пункт: сірий */
  a:hover, a[aria-current='page'] { color: var(--color-text-muted); }

  .services ul { padding-left: 1em; }

  /* Телефон: ім'я і меню в один рядок, решта прихована */
  .name { grid-column: 1 / 7; }
  .locations, .services { display: none; }
  .nav { grid-column: 7 / -1; display: flex; justify-content: flex-end; gap: var(--space-xs); }

  /* Зони дотику на телефоні */
  @media (max-width: 1023px) {
    .name, .nav a { display: inline-flex; align-items: center; min-height: var(--tap-min); }
    .site-header { padding-block: var(--space-3xs); }
  }

  /* Планшет: додаємо міста */
  @media (min-width: 768px) {
    .name { grid-column: 1 / 4; }
    .locations { display: block; grid-column: 4 / 8; }
    .nav { grid-column: 8 / -1; }
  }

  /* Десктоп: повна шапка як у референсі */
  @media (min-width: 1024px) {
    .name { grid-column: 1 / 3; }
    .locations { grid-column: 3 / 6; }
    .services { display: block; grid-column: 6 / 9; }
    .nav { grid-column: 9 / -1; display: grid; grid-template-columns: subgrid; }
    .blog { grid-column: 1 / 4; }
    .pair { grid-column: 4 / -1; justify-self: end; }
  }
</style>
