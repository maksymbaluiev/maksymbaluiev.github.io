---
import { SITE } from '../site.config';

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' || path.startsWith('/work/') : path.startsWith(href);
---

<header class="site-header cols14">
  <a class="name" href="/">{SITE.name}</a>
  <p class="tagline">Designer, {SITE.location.split(',')[0]}</p>
  <nav aria-label="Main">
    <ul role="list">
      {
        SITE.nav.map((item) => (
          <li>
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <a class="email" href={`mailto:${SITE.email}`}>Email me</a>
</header>

<style>
  /* Та сама 14-колонкова сітка, що й на сторінках */
  .site-header {
    align-items: center;
    padding-block: var(--space-2xs);
  }
  a { text-decoration: none; }
  a:hover { color: var(--color-text-muted); }
  .name, nav a, .email {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
  }
  .name { grid-column: 1 / 6; }
  .tagline { display: none; }
  nav { grid-column: 6 / 12; }
  .email { grid-column: 12 / -1; justify-self: end; }
  ul { display: flex; gap: var(--space-2xs); }
  nav a { padding-inline: 0.45em; border-radius: 0.3em; }
  nav a[aria-current='page'] { background: var(--color-pill); }

  @media (min-width: 768px) {
    .name { grid-column: 1 / 3; }
    .tagline { display: block; grid-column: 3 / 6; }
    nav { grid-column: 9 / 13; }
    .email { grid-column: 13 / -1; }
  }
</style>
