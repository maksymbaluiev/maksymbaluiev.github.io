---
import { SITE } from '../site.config';

const path = Astro.url.pathname;
const blog = SITE.nav.find((n) => n.label === 'Blog');
const rest = SITE.nav.filter((n) => n.label !== 'Blog');
const isActive = (href: string) => path.startsWith(href);
---

<header class="site-header cols" data-menu>
  <a class="name" href="/">{SITE.name}</a>

  <!-- Кнопка меню, лише на телефоні: «+» повертається і стає «×» -->
  <button class="toggle" type="button" aria-expanded="false" aria-controls="site-menu" aria-label="Menu">
    <span aria-hidden="true">+</span>
  </button>

  <!--
    На телефоні це висувна панель справа.
    Від 880 px панель «розчиняється» (display: contents), і її пункти стають колонками шапки.
  -->
  <div class="panel" id="site-menu">
    <nav aria-label="Main" class="nav">
      {blog && (
        <a class="blog" href={blog.href} aria-current={isActive(blog.href) ? 'page' : undefined}>{blog.label}</a>
      )}
      {rest.map((item) => (
        <a class="pair" href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
      ))}
    </nav>

    <ul role="list" class="locations">
      {SITE.locations.map((l) => <li>{l}</li>)}
    </ul>

    <div class="services">
      <p class="label">Services</p>
      <ul role="list">
        {SITE.headerServices.map((s) => <li>{s}</li>)}
      </ul>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-menu]');
  const toggle = header?.querySelector<HTMLButtonElement>('.toggle');
  const setOpen = (open: boolean) => {
    if (!header || !toggle) return;
    header.classList.toggle('is-open', open);
    toggle.setAttribute('aria-expanded', String(open));
    const lenis = (window as any).lenis;
    if (lenis) open ? lenis.stop() : lenis.start();
  };
  toggle?.addEventListener('click', () => setOpen(!header!.classList.contains('is-open')));
  document.addEventListener('keydown', (e) => e.key === 'Escape' && setOpen(false));
  header?.querySelectorAll('.panel a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  // Якщо екран став широким, меню закривається
  window.matchMedia('(min-width: 880px)').addEventListener('change', () => setOpen(false));
</script>

<style>
  /*
    12 колонок (десктоп):
    1 ім'я · 3 міста · 5 послуги · 7 Blog · праворуч About | Contact
  */
  .site-header {
    align-items: start;
    padding-block: var(--space-xs);
    row-gap: var(--space-2xs);
  }
  a { text-decoration: none; }

  /* Наведення і активний пункт: сірий */
  a:hover, a[aria-current='page'] { color: var(--color-text-muted); }

  /* ——— Телефон і вузький планшет (до 880 px): ім'я + кнопка, меню у висувній панелі ——— */
  .site-header { padding-block: var(--space-3xs); position: relative; z-index: 20; }
  .name { grid-column: 1 / -2; display: inline-flex; align-items: center; min-height: var(--tap-min); }

  .toggle {
    grid-column: -2 / -1;
    justify-self: end;
    position: relative;
    z-index: 2; /* над панеллю, щоб нею ж закривати */
    width: var(--tap-min);
    height: var(--tap-min);
    margin-right: -0.6rem;
    display: grid;
    place-items: center;
    background: none;
    border: 0;
    color: inherit;
    font: inherit;
    font-size: 1.75rem;
    font-weight: 300;
    line-height: 1;
    cursor: pointer;
  }
  .toggle span { display: block; transition: transform 0.35s var(--ease); }
  .is-open .toggle span { transform: rotate(45deg); }

  .panel {
    position: fixed;
    inset: 0 0 0 auto;
    width: min(82vw, 22rem);
    padding: calc(var(--tap-min) + var(--space-l)) var(--pad) var(--space-l);
    display: flex;
    flex-direction: column;
    gap: var(--space-l);
    background: rgba(0, 0, 0, 0.72);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    transform: translateX(100%);
    visibility: hidden;
    transition: transform 0.4s var(--ease), visibility 0s linear 0.4s;
    overflow-y: auto;
  }
  .is-open .panel {
    transform: none;
    visibility: visible;
    transition: transform 0.4s var(--ease);
  }
  .nav { display: flex; flex-direction: column; }
  .nav a { display: inline-flex; align-items: center; min-height: var(--tap-min); }

  /* ——— Від 880 px: звичайна шапка в колонках (вужче — бургер, бо ім'я не влазить у 2 колонки) ———
     Усі пункти вирівняні по верху; однаковий відступ зверху дає їм спільну лінію
     і водночас збільшує зону дотику. */
  @media (min-width: 880px) {
    .site-header { padding-block: 0 var(--space-3xs); }
    .toggle { display: none; }
    .panel {
      display: contents;
      visibility: visible;
    }
    .name, .nav a, .locations, .services { padding-top: var(--space-xs); }
    .name, .nav a { display: inline-block; min-height: 0; padding-bottom: var(--space-2xs); }

    /* Проміжний стан (880–1023): ім'я · Blog у 3-й колонці з 6 (= 5-та з 12, на одній лінії з назвами розділів About) · About | Contact праворуч */
    .name { grid-column: 1 / 3; grid-row: 1; }
    .locations, .services { display: none; }
    .nav { grid-column: 5 / -1; grid-row: 1; display: grid; grid-template-columns: subgrid; }
    .blog { grid-column: 1 / 3; }
    .pair { grid-column: 3 / -1; justify-self: end; }
  }

  /* Десктоп (від 1024): ім'я 1 · міста 3 · послуги 5 · Blog 7 · About | Contact праворуч */
  @media (min-width: 1024px) {
    .locations { display: block; grid-column: 3 / 5; grid-row: 1; }
    .services { display: block; grid-column: 5 / 7; grid-row: 1; }
    .nav { grid-column: 7 / -1; }
  }
</style>
