---
import { Picture } from 'astro:assets';
import type { ProjectImage } from '../lib/projects';

interface Props { images: ProjectImage[] }
const { images } = Astro.props;
---

<div class="gallery">
  {
    images.map((img, i) => (
      <figure>
        <Picture
          src={img.src}
          alt={img.alt}
          formats={['avif', 'webp']}
          widths={[640, 960, 1280, 1600, 2000, 2400, 3200, 4800]}
          sizes="(min-width: 2600px) 2400px, calc(100vw - 2rem)"
          loading={i === 0 ? 'eager' : 'lazy'}
        />
      </figure>
    ))
  }
</div>

<style>
  .gallery {
    display: grid;
    gap: var(--grid-gap);
    max-width: var(--media-max);
    margin-inline: auto;
  }
  figure { background: var(--color-surface); }
  figure :global(img) { width: 100%; }
</style>
