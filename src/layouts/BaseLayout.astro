---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../site.config';

interface Props {
  title?: string;
  description?: string;
  /** Абсолютний або кореневий шлях до OG-картинки */
  image?: string;
  type?: 'website' | 'article';
}

const { title, description = SITE.description, image = '/og-default.png', type = 'website' } = Astro.props;
const fullTitle = title ? `${title} — ${SITE.name}` : `${SITE.name} — Designer, Zurich`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0b0b0b" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body id="top">
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <!-- М'який скрол (Lenis, як у референсі). Вимкнений, якщо в системі «зменшити рух». -->
    <script>
      import Lenis from 'lenis';
      import 'lenis/dist/lenis.css';

      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const lenis = reduce ? null : new Lenis({ autoRaf: true, allowNestedScroll: true });
      (window as any).lenis = lenis;

      // Стрілка «вгору»: плавно на початок сторінки
      document.querySelectorAll<HTMLAnchorElement>('a[href="#top"]').forEach((a) =>
        a.addEventListener('click', (e) => {
          e.preventDefault();
          if (lenis) lenis.scrollTo(0);
          else window.scrollTo(0, 0);
        }),
      );
    </script>
  </body>
</html>
